# Server
PORT=3001
NODE_ENV=development

# SQL Server — base de datos SistemaNegocio
DB_SERVER=DESKTOP-T1FGP81\\SQLEXPRESS
DB_NAME=SistemaNegocio

# Autenticación integrada de Windows (usa la cuenta de Windows que ejecuta Node)
DB_AUTH_MODE=windows

# Solo si DB_AUTH_MODE=sql: cree/habilite un login SQL y configure sus credenciales.
# DB_USER=
# DB_PASSWORD=

# Opciones de conexión
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_REQUEST_TIMEOUT_MS=30000

# Autenticación API
JWT_SECRET=REEMPLACE_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
MAX_FAILED_LOGIN_ATTEMPTS=2

# Seed inicial (npm run seed) — no commitear contraseñas reales
SEED_ADMIN_PASSWORD=
SEED_ADMIN1_USERNAME=admin1
SEED_ADMIN1_NOMBRE=Administrador Uno
SEED_ADMIN2_USERNAME=admin2
SEED_ADMIN2_NOMBRE=Administrador Dos
SEED_CAJERO_USERNAME=Cajero
SEED_CAJERO_NOMBRE=Cajero
SEED_COMPRAS_USERNAME=Encargado de compras
SEED_COMPRAS_NOMBRE=Encargado de compras
