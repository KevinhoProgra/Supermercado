{
  "name": "supermercado-erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes --package=node@22 --call \"node src/server.js\"",
    "dev": "npx --yes --package=node@22 --call \"node --watch src/server.js\"",
    "test": "npx --yes --package=node@22 --call \"node --test test/**/*.test.js\"",
    "db:check": "npx --yes --package=node@22 --call \"node scripts/check-db.js\"",
    "seed": "npx --yes --package=node@22 --call \"node scripts/seed.js\""
  },
  "engines": {
    "node": ">=18 <=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "msnodesqlv8": "^4.5.0",
    "mssql": "^11.0.1"
  }
}
